<Window x:Class="WpfApp3.Window2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp3"
        mc:Ignorable="d"
        Title="Window2" Height="450" Width="800">
    <Grid>

			<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="500">

				<!-- Titre principal -->
				<TextBlock Text="🎨 Choix de l'esthétique"
                       FontSize="26" FontWeight="Bold"
                       Foreground="White" TextAlignment="Center"
                       Margin="0,0,0,20"/>

				<!-- Ligne des 3 colonnes -->
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<!-- Couleur des pièces -->
					<StackPanel Grid.Column="0" HorizontalAlignment="Center">
						<TextBlock Text="Couleur des pièces"
                               Foreground="#AAAACC" FontSize="13" FontWeight="SemiBold"
                               TextAlignment="Center" Margin="0,0,0,8"/>
						<ComboBox x:Name="CbCouleurPieces" Width="140"
                              Background="#2E2E4E" Foreground="White"
                              BorderBrush="#5555AA" SelectionChanged="Couleur_SelectionChanged">
							<ComboBoxItem Content="🔴 Rouge"  Tag="Red"/>
							<ComboBoxItem Content="🟡 Jaune"  Tag="Yellow"/>
							<ComboBoxItem Content="🔵 Bleu"   Tag="Blue"/>
							<ComboBoxItem Content="🟢 Vert"   Tag="Green"/>
							<ComboBoxItem Content="🟠 Orange" Tag="Orange"/>
							<ComboBoxItem Content="⚪ Blanc"  Tag="White"/>
						</ComboBox>
					</StackPanel>

					<!-- Couleur des formes -->
					<StackPanel Grid.Column="1" HorizontalAlignment="Center">
						<TextBlock Text="Couleur des formes"
                               Foreground="#AAAACC" FontSize="13" FontWeight="SemiBold"
                               TextAlignment="Center" Margin="0,0,0,8"/>
						<ComboBox x:Name="CbCouleurFormes" Width="140"
                              Background="#2E2E4E" Foreground="White"
                              BorderBrush="#5555AA" SelectionChanged="Couleur_SelectionChanged">
							<ComboBoxItem Content="🔴 Rouge"  Tag="Red"/>
							<ComboBoxItem Content="🟡 Jaune"  Tag="Yellow"/>
							<ComboBoxItem Content="🔵 Bleu"   Tag="Blue"/>
							<ComboBoxItem Content="🟢 Vert"   Tag="Green"/>
							<ComboBoxItem Content="🟠 Orange" Tag="Orange"/>
							<ComboBoxItem Content="⚪ Blanc"  Tag="White"/>
						</ComboBox>
					</StackPanel>

					<!-- Couleur de la grille -->
					<StackPanel Grid.Column="2" HorizontalAlignment="Center">
						<TextBlock Text="Couleur de la grille"
                               Foreground="#AAAACC" FontSize="13" FontWeight="SemiBold"
                               TextAlignment="Center" Margin="0,0,0,8"/>
						<ComboBox x:Name="CbCouleurGrille" Width="140"
                              Background="#2E2E4E" Foreground="White"
                              BorderBrush="#5555AA" SelectionChanged="Couleur_SelectionChanged">
							<ComboBoxItem Content="🔵 Bleu"   Tag="Blue"/>
							<ComboBoxItem Content="⚫ Noir"   Tag="Black"/>
							<ComboBoxItem Content="⚪ Blanc"  Tag="White"/>
							<ComboBoxItem Content="🟣 Violet" Tag="Purple"/>
							<ComboBoxItem Content="🩶 Gris"   Tag="Gray"/>
						</ComboBox>
					</StackPanel>

				</Grid>

				<!-- Aperçu -->
				<Border CornerRadius="12" Padding="16" Margin="0,20,0,0"
                    Background="#2A2A3E" BorderBrush="#444466" BorderThickness="1">
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
						<Ellipse x:Name="PreviewPiece1" Width="40" Height="40" Margin="8"
                             Fill="Red"/>
						<Ellipse x:Name="PreviewPiece2" Width="40" Height="40" Margin="8"
                             Fill="Yellow"/>
						<Rectangle x:Name="PreviewGrille" Width="80" Height="40" Margin="8"
                               RadiusX="6" RadiusY="6" Fill="Blue"/>
					</StackPanel>
				</Border>

				<!-- Boutons navigation -->
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
					<Button Content="← Retour" Width="130" Height="40" Margin="0,0,20,0"
                        Background="#333355" Foreground="White" BorderThickness="0"
                        FontSize="14" Cursor="Hand" Click="BtnRetour_Click">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,6">
									<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>
							</ControlTemplate>
						</Button.Template>
					</Button>
					<Button Content="Suivant →" Width="130" Height="40"
                        Background="#5555FF" Foreground="White" BorderThickness="0"
                        FontSize="14" FontWeight="Bold" Cursor="Hand" Click="BtnSuivant_Click">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,6">
									<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>
							</ControlTemplate>
						</Button.Template>
					</Button>
				</StackPanel>

			</StackPanel>
		</Grid>
</Window>

