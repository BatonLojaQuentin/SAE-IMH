<Window x:Class="WpfApp3.pageparamètre"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres d'esthétique" Height="450" Width="500" Background="#F5F5F5">

    <Grid Margin="20">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">

            <TextBlock Text="Paramètres" FontSize="31" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,5"/>
            <TextBlock Text="Paramètres d'esthétique" FontSize="18" Foreground="Gray" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <Grid Height="126" Width="330">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="134"/>
                    <ColumnDefinition Width="196"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Couleur des pièces :" VerticalAlignment="Center" FontSize="14" Grid.Column="0" Height="19"/>
                <ComboBox Grid.Column="1" VerticalAlignment="Center" SelectedIndex="0" Height="21">
                    <ComboBoxItem Content="Rouge"/>
                    <ComboBoxItem Content="Bleu"/>
                    <ComboBoxItem Content="Vert"/>
                </ComboBox>

                <TextBlock Text="Forme des pièces :" VerticalAlignment="Center" FontSize="14" Grid.Row="1" Grid.Column="0" Height="19"/>
                <ComboBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" SelectedIndex="0" Height="21">
                    <ComboBoxItem Content="rond"/>
                    <ComboBoxItem Content="carré"/>
                    <ComboBoxItem Content="hexagonale"/>
                </ComboBox>

                <TextBlock Text="Couleur de grille :" VerticalAlignment="Center" FontSize="14" Grid.Row="2" Grid.Column="0" Height="19"/>
                <ComboBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" SelectedIndex="0" Height="21">
                    <ComboBoxItem Content="Rouge"/>
                    <ComboBoxItem Content="Bleu"/>
                    <ComboBoxItem Content="Vert"/>
                </ComboBox>
            </Grid>

            <Button Content="Valider et Fermer" Width="160" Height="40" Margin="0,40,0,0" Background="LightGreen" FontWeight="Bold" Click="BtnFermer_Click"/>
        </StackPanel>
    </Grid>
</Window>