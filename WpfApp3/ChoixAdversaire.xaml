<Window x:Class="WpfApp3.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp3"
        mc:Ignorable="d"
        Title="Window1" Height="450" Width="800">
 
          <Grid Margin="20">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                    <TextBlock Text="Choisissez votre adversaire" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,40">
                        <RadioButton x:Name="RadHumain" Content="Affronter un Humain (Local)" IsChecked="True" Margin="0,0,40,0"/>
                        <RadioButton x:Name="RadRobot" Content="Affronter l'IA (Robot)"/>
                    </StackPanel>

                    <Button Content="Lancer la partie !" Width="180" Height="45" Background="LightBlue" FontWeight="Bold" Click="BtnLancer_Click"/>

                </StackPanel>
          
    </Grid>
</Window>
