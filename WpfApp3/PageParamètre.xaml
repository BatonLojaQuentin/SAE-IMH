<Window x:Class="WpfApp3.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp3"
        mc:Ignorable="d"
        Title="Window1" Height="450" Width="800">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="176*"/>
			<ColumnDefinition Width="435*"/>
			<ColumnDefinition Width="189*"/>
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="118*"/>
			<RowDefinition Height="187*"/>
			<RowDefinition Height="129*"/>
		</Grid.RowDefinitions>
		<TextBlock Text="Paramètres" 
           FontSize="32" 
           FontWeight="Bold" 
           HorizontalAlignment="Left" 
           VerticalAlignment="Center" Height="40" Width="170" Grid.Column="1" Margin="139,0,0,0"/>

		<StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="1" Margin="167,0,0,0" Grid.ColumnSpan="3" Height="155" Width="466">

			<TextBlock Text="Faites votre choix :" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
				<RadioButton Content="je suis malvoyant" 
                         GroupName="MesOptions" 
                         FontSize="30" 
                         Margin="0,0,30,0" 
                         IsChecked="True"/>
				<RadioButton Content="je ne suis pas malvoyant" 
                         GroupName="MesOptions" 
                         FontSize="16" Checked="RadioButton_Checked"/>
			</StackPanel>

			<Button Content="Valider" 
                Width="120" 
                Height="40" 
                FontSize="18" 
                Margin="0,30,0,0" 
                HorizontalAlignment="Center"
                Click="BtnValider_Click"/>

		</StackPanel>
	</Grid>
</Window>
